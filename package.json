{
  "name": "notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet, macOS-flavoured notes app: subjects > topics > notes, block editor, link library, local-first storage.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run smoke",
    "smoke": "esbuild test/entry.ts --bundle --outfile=test/.tmp/app.cjs --format=cjs --platform=browser --loader:.css=text --define:import.meta.env.PROD=false --log-level=error && node test/smoke.mjs",
    "test:unit": "esbuild test/md.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/md.test.mjs --log-level=error && node node_modules/.tmp/md.test.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
